# OpenRouter — answers (LLM) and embeddings (openai/text-embedding-3-small)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=...
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_REASONING=false

# Reranking
COHERE_API_KEY=...

# Auth — set to a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=...

# Langfuse tracing — optional, leave blank to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
